# ============================================================
# FeedPulse AI — Environment Configuration Example
# Copy this file to .env and customize values for your deployment
# ============================================================

APP_NAME="FeedPulse AI"
APP_ENV=production
APP_URL=http://localhost/feedpulse-ai
CRON_SECRET=feedpulse_super_secret_cron_token_change_me

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=feedpulse_ai
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Mail / SMTP Configuration
MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your_smtp_user
MAIL_PASS=your_smtp_pass
MAIL_FROM_ADDRESS=noreply@feedpulse.edu
MAIL_FROM_NAME="FeedPulse AI Portal"
